{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "home-dashboard",
  "compatibility_date": "2026-09-30",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "home-dashboard-photos"
    }
  ]
}